# MaxKB FastAPI backend — environment variables (compat with legacy MAXKB_*).
# Copy to .env and adjust. All variables are OPTIONAL (defaults mirror conf.py).

# Service role: web | local_model
SERVER_NAME=web

# Database
MAXKB_DB_HOST=127.0.0.1
MAXKB_DB_PORT=5432
MAXKB_DB_NAME=maxkb
MAXKB_DB_USER=root
MAXKB_DB_PASSWORD=Password123@postgres
MAXKB_DB_MAX_OVERFLOW=80

# Redis
MAXKB_REDIS_HOST=127.0.0.1
MAXKB_REDIS_PORT=6379
MAXKB_REDIS_PASSWORD=Password123@redis
MAXKB_REDIS_DB=0
MAXKB_REDIS_MAX_CONNECTIONS=100
# MAXKB_REDIS_SENTINEL_SENTINELS=host1:26379,host2:26379
# MAXKB_REDIS_SENTINEL_MASTER=mymaster

# Local model service
MAXKB_LOCAL_MODEL_HOST=127.0.0.1
MAXKB_LOCAL_MODEL_PORT=11636
MAXKB_LOCAL_MODEL_PROTOCOL=http
MAXKB_LOCAL_MODEL_HOST_WORKER=1

# General
MAXKB_DEBUG=false
MAXKB_LANGUAGE_CODE=zh-CN
MAXKB_TIME_ZONE=Asia/Shanghai
MAXKB_LOG_LEVEL=DEBUG
MAXKB_SANDBOX_PYTHON_PACKAGE_PATHS=/opt/py3/lib/python3.11/site-packages,/opt/maxkb-app/sandbox/python-packages,/opt/maxkb/python-packages
MAXKB_ADMIN_PATH=/admin
MAXKB_CHAT_PATH=/chat

# HTTP server
MAXKB_WEB_HOST=0.0.0.0
MAXKB_WEB_PORT=8080
# API URL prefixes (must match the legacy frontend proxy: /admin/api and /chat/api).
# conf.py defaults api_prefix to "/api" — override here so the frontend does not 404.
MAXKB_API_PREFIX=/admin/api
MAXKB_CHAT_API_PREFIX=/chat/api
MAXKB_SESSION_TIMEOUT=28800
MAXKB_EXTERNAL_LOCALE_PATH=/opt/maxkb/local/locales
