# 仓库根 .env —— apps(Django)后端 ENV 模式对照配置
# 仅当设置 MAXKB_CONFIG_TYPE=ENV 时由 conf.py 的 load_from_env 读取(键名剥去 MAXKB_ 前缀)。
# 默认 FILE 模式(读 config.yaml)下这些变量会被忽略,可放心保留。
# 注意:MAXKB_CONFIG=1 使 const.py 从仓库根读取配置。

MAXKB_CONFIG=1

# 数据库 (PostgreSQL + pgvector)
MAXKB_DB_NAME=maxkb
MAXKB_DB_HOST=127.0.0.1
MAXKB_DB_PORT=5432
MAXKB_DB_USER=chenpp
MAXKB_DB_PASSWORD=
MAXKB_DB_ENGINE=dj_db_conn_pool.backends.postgresql
MAXKB_DB_MAX_OVERFLOW=80

# Redis
MAXKB_REDIS_HOST=127.0.0.1
MAXKB_REDIS_PORT=6379
MAXKB_REDIS_PASSWORD=
MAXKB_REDIS_DB=0
MAXKB_REDIS_MAX_CONNECTIONS=100

# 语言
MAXKB_LANGUAGE_CODE=zh-CN
